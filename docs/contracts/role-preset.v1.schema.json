{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-fleet:contract:role-preset:1.0.0",
  "title": "Role preset registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "presets"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_id",
        "preset_version",
        "role",
        "enabled",
        "worker",
        "dsh_profile",
        "plugin_manifest",
        "mcp_server",
        "tool_profile",
        "allowed_tools",
        "input_schema_id",
        "output_schema_id",
        "workspace_visibility",
        "data_scope",
        "max_timeout_ms",
        "default_timeout_ms",
        "max_concurrent",
        "max_output_bytes",
        "max_budget",
        "env_allowlist",
        "requires_approval"
      ],
      "properties": {
        "preset_id": { "type": "string", "pattern": "^preset_[a-z][a-z0-9_]{2,63}$" },
        "preset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "role": { "enum": ["orchestrator", "researcher", "vehicle_analyst", "challenger", "evidence_verifier", "lab_runner"] },
        "enabled": { "type": "boolean" },
        "worker": { "type": "boolean" },
        "dsh_profile": { "type": "string", "minLength": 1, "maxLength": 128 },
        "plugin_manifest": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/pluginRef" }
        },
        "mcp_server": { "type": ["string", "null"], "maxLength": 128 },
        "tool_profile": { "type": ["string", "null"], "maxLength": 128 },
        "allowed_tools": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }
        },
        "input_schema_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "output_schema_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workspace_visibility": { "enum": ["bound-workspace", "none"] },
        "data_scope": { "enum": ["read-only", "none"] },
        "max_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "default_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "max_concurrent": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_output_bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "max_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_tokens", "max_cost_usd"],
          "properties": {
            "max_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "max_cost_usd": { "type": "number", "minimum": 0, "maximum": 1000 }
          }
        },
        "env_allowlist": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,63}$" }
        },
        "requires_approval": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 512 }
      }
    },
    "pluginRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "version", "enabled"],
      "properties": {
        "plugin_id": { "type": "string", "pattern": "^fleet\\.[a-z][a-z0-9-]{1,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
