{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-fleet:contract:workflow-registry:1.0.0",
  "title": "Workflow registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "workflows"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "version", "enabled", "default", "tasks"],
      "properties": {
        "workflow_id": { "enum": ["single", "research", "design_review", "lab_validation", "security_audit"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "enabled": { "type": "boolean" },
        "default": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 512 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "allowed_roles", "worker", "requires_approval", "depends_on"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "allowed_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["orchestrator", "researcher", "vehicle_analyst", "challenger", "evidence_verifier", "lab_runner"] }
        },
        "worker": { "type": "boolean" },
        "requires_approval": { "type": "boolean" },
        "depends_on": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }
        },
        "description": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
