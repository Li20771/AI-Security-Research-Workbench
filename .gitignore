# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets/

# Agent local state
.ai/
workspace-state/
*.session.json

# Generated evidence / benchmark / workflow data
evidence/runs/*
!evidence/runs/.gitkeep

# AI-05 staged Evidence. Local and discardable (B2 decision D4/D5): a staged
# record may be discarded as a whole, so it is not committed. `evidence/promoted/`
# is deliberately NOT listed here — a promoted record is durable via Git and is
# retained by it.
evidence/staged/*
!evidence/staged/.gitkeep
benchmarks/results/*
!benchmarks/results/.gitkeep
workflows/runs/*
!workflows/runs/.gitkeep
workflows/checkpoints/*
!workflows/checkpoints/.gitkeep
artifacts/
reports/generated/

# Editors
.vscode/
.idea/
*.swp
*.swo